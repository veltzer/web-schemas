{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "city.json",
	"description": "City element",
	"$defs": {
		"city": {
			"description": "A valid city name",
			"type": "string",
			"enum": [
				"Tel-Aviv",
				"Moscow",
				"Jerusalem",
				"London",
				"Barcelona",
				"New York",
				"Kiev",
				"Paris",
				"Arad",
				"Beit Zayit",
				"Binyamina",
				"Caesarea",
				"Eilat",
				"Givatayim",
				"Haifa",
				"Herzliya",
				"Kfar Vitkin",
				"Limassol",
				"Mishmarot",
				"Neve Ilan",
				"Ramat Hasharon",
				"Rishon LeZion"
			]
		},
		"cities": {
			"description": "A collection of cities",
			"type": "array",
			"items": {
				"$ref": "#/$defs/city"
			}
		}
	}
}
